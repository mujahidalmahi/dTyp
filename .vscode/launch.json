{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch dTyp Extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build:vscode"
    }
  ]
}
