[
  {
    "id": "memory.safeMalloc",
    "name": "safeMalloc",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Allocates heap memory and terminates safely if allocation fails.",
    "signature": "void* safeMalloc(size_t size)",
    "code": "void* safeMalloc(size_t size) {\n    if (size == 0) return NULL;\n    void* ptr = malloc(size);\n    if (!ptr) {\n        fprintf(stderr, \"Out of memory!\\n\");\n        exit(1);\n    }\n    return ptr;\n}",
    "complexity": {
      "time": "O(1)",
      "space": "O(1)"
    },
    "dependencies": [],
    "tags": [
      "allocator",
      "safety"
    ],
    "version": "1.0.0"
  },
  {
    "id": "memory.safeCalloc",
    "name": "safeCalloc",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Allocates zero-initialized heap memory safely.",
    "signature": "void* safeCalloc(size_t count, size_t size)",
    "code": "void* safeCalloc(size_t count, size_t size) {\n    if (count == 0 || size == 0) return NULL;\n    void* ptr = calloc(count, size);\n    if (!ptr) {\n        fprintf(stderr, \"Out of memory in calloc!\\n\");\n        exit(1);\n    }\n    return ptr;\n}",
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    },
    "dependencies": [],
    "tags": [
      "allocator",
      "zeroed"
    ],
    "version": "1.0.0"
  },
  {
    "id": "memory.safeFree",
    "name": "safeFree",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Frees pointer and sets it to NULL to prevent dangling references.",
    "signature": "void safeFree(void** ptr)",
    "code": "void safeFree(void** ptr) {\n    if (ptr && *ptr) {\n        free(*ptr);\n        *ptr = NULL;\n    }\n}",
    "complexity": {
      "time": "O(1)",
      "space": "O(1)"
    },
    "dependencies": [],
    "tags": [
      "deallocation",
      "safety"
    ],
    "version": "1.0.0"
  },
  {
    "id": "memory.allocate2DArray",
    "name": "allocate2DArray",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Allocates a contiguous 2D integer array dynamically.",
    "signature": "int** allocate2DArray(int rows, int cols)",
    "code": "int** allocate2DArray(int rows, int cols) {\n    if (rows <= 0 || cols <= 0) return NULL;\n    int** matrix = (int**)malloc(rows * sizeof(int*));\n    if (!matrix) return NULL;\n    matrix[0] = (int*)calloc(rows * cols, sizeof(int));\n    if (!matrix[0]) { free(matrix); return NULL; }\n    for (int i = 1; i < rows; i++) matrix[i] = matrix[0] + i * cols;\n    return matrix;\n}",
    "complexity": {
      "time": "O(rows * cols)",
      "space": "O(rows * cols)"
    },
    "dependencies": [],
    "tags": [
      "matrix",
      "2D"
    ],
    "version": "1.0.0"
  },
  {
    "id": "memory.free2DArray",
    "name": "free2DArray",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Frees a contiguous 2D integer array allocated by allocate2DArray.",
    "signature": "void free2DArray(int** matrix)",
    "code": "void free2DArray(int** matrix) {\n    if (matrix) {\n        if (matrix[0]) free(matrix[0]);\n        free(matrix);\n    }\n}",
    "complexity": {
      "time": "O(1)",
      "space": "O(1)"
    },
    "dependencies": [],
    "tags": [
      "matrix",
      "free"
    ],
    "version": "1.0.0"
  },
  {
    "id": "memory.safeRealloc",
    "name": "safeRealloc",
    "language": "c",
    "category": "memory",
    "subcategory": "memory",
    "description": "Dynamic memory management helper: safeRealloc.",
    "signature": "void* safeRealloc(size_t size, int flags)",
    "code": "void* safeRealloc(size_t size, int flags) {\n    if (size == 0) return NULL;\n    void* p = malloc(size);\n    if (p && flags) memset(p, 0, size);\n    return p;\n}",
    "complexity": {
      "time": "O(1)",
      "space": "O(size)"
    },
