  {
    "id": "heap.MinHeap",
    "name": "MinHeap",
    "language": "c",
    "category": "heap",
    "subcategory": "heap",
    "description": "Array-backed binary Min-Heap structure.",
    "signature": "typedef struct MinHeap MinHeap;",
    "code": "typedef struct MinHeap {\n    int* arr;\n    int capacity;\n    int heapSize;\n} MinHeap;",
    "complexity": {
      "time": "O(1)",
      "space": "O(1)"
    },
    "dependencies": [],
