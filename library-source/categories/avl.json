    "id": "avl.AVLNode",
    "name": "AVLNode",
    "language": "c",
    "category": "avl",
    "subcategory": "avl",
    "description": "AVL tree node struct storing height.",
    "signature": "typedef struct AVLNode AVLNode;",
    "code": "typedef struct AVLNode {\n    int key;\n    struct AVLNode* left;\n    struct AVLNode* right;\n    int height;\n} AVLNode;",
