      {
        "command": "dtyp.benchmarkComponent",
        "title": "dTyp: Benchmark Empirical Complexity",
        "category": "dTyp",
        "icon": "$(graph)"
      },
      {
        "command": "dtyp.openFlashcards",
        "title": "dTyp: Open Exam Flashcards & Cheat Sheets",
        "category": "dTyp",
        "icon": "$(mortar-board)"
      },
      {
        "command": "dtyp.toggleSteppingHud",
        "title": "dTyp: Toggle Floating Stepping HUD",
        "category": "dTyp",
        "icon": "$(dashboard)"
      },
      {
        "command": "dtyp.showShortcuts",
        "title": "dTyp: View Keyboard Shortcuts & Cheatsheet",
        "category": "dTyp",
        "icon": "$(keyboard)"
      },
      {
        "command": "dtyp.formatAcademic",
        "title": "dTyp: Format Code with Academic Pure Tabs",
        "category": "dTyp",
        "icon": "$(wand)"
      },
      {
        "command": "dtyp.auditCode",
        "title": "dTyp: Audit C Code for Academic Defects (Ctrl+F8)",
        "category": "dTyp",
        "icon": "$(checklist)"
      },
      {
        "command": "dtyp.scaffoldContest",
        "title": "dTyp: Scaffold Competitive Programming Arena (Ctrl+F9)",
        "category": "dTyp",
        "icon": "$(flame)"
      },
      {
        "command": "dtyp.visualizeRecursion",
        "title": "dTyp: Visualize Live Recursion Tree & Call Stack",
        "category": "dTyp",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "dtyp.runValgrind",
        "title": "dTyp: Run Valgrind Deep Leak Profiler",
        "category": "dTyp",
        "icon": "$(microscope)"
      },
      {
        "command": "dtyp.openTypingDrill",
        "title": "dTyp: Open C Typing Speed & Muscle Memory Drill",
        "category": "dTyp",
        "icon": "$(zap)"
      },
      {
        "command": "dtyp.openControlCenter",
        "title": "dTyp: Open Control Center & Master Hub",
        "category": "dTyp",
        "icon": "$(dashboard)"
      },
      {
        "command": "dtyp.openStatusBarMenu",
        "title": "dTyp: Open Master Tools & Actions Menu",
        "category": "dTyp",
        "icon": "$(menu)"
      }
    ],
    "keybindings": [
      {
        "command": "dtyp.typeNextCharacter",
        "key": "ctrl+shift+d",
        "when": "editorTextFocus && dtyp.hasQueuedCharacters"
      },
      {
        "command": "dtyp.browseLibrary",
        "key": "ctrl+alt+d"
      },
      {
        "command": "dtyp.cancelTyping",
        "key": "escape",
        "when": "editorTextFocus && (dtyp.isTyping || dtyp.hasQueuedCharacters)"
      },
      {
        "command": "dtyp.togglePauseTyping",
        "key": "alt+p",
        "when": "editorTextFocus && (dtyp.isTyping || dtyp.hasQueuedCharacters)"
      },
      {
        "command": "dtyp.jumpToNextPlaceholder",
        "key": "alt+down",
        "when": "editorTextFocus && dtyp.hasPlaceholders"
      },
      {
        "command": "dtyp.jumpToPrevPlaceholder",
        "key": "alt+up",
        "when": "editorTextFocus && dtyp.hasPlaceholders"
      },
      {
        "command": "dtyp.renewQueue",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && (dtyp.isTyping || dtyp.hasQueuedCharacters || dtyp.hasLastInsertion)"
      },
      {
        "command": "dtyp.rewindStep",
        "key": "ctrl+shift+u",
        "when": "editorTextFocus && dtyp.hasQueuedCharacters"
      },
      {
        "command": "dtyp.compileAndRun",
        "key": "ctrl+f5",
        "when": "editorTextFocus && (resourceExtname == .c || resourceExtname == .cpp)"
      },
      {
        "command": "dtyp.speedUpTyping",
        "key": "ctrl+]",
        "when": "editorTextFocus && dtyp.isTyping"
      },
      {
        "command": "dtyp.slowDownTyping",
        "key": "ctrl+[",
        "when": "editorTextFocus && dtyp.isTyping"
      },
      {
        "command": "dtyp.toggleChameleonMode",
        "key": "alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "dtyp.runTestCases",
        "key": "ctrl+f6",
        "when": "editorTextFocus && (resourceExtname == .c || resourceExtname == .cpp)"
      },
      {
        "command": "dtyp.runSanitizer",
        "key": "ctrl+f7",
        "when": "editorTextFocus && (resourceExtname == .c || resourceExtname == .cpp)"
      },
      {
        "command": "dtyp.formatAcademic",
        "key": "shift+alt+f",
        "when": "editorTextFocus && (resourceExtname == .c || resourceExtname == .cpp)"
      },
      {
        "command": "dtyp.auditCode",
        "key": "ctrl+f8",
        "when": "editorTextFocus && (resourceExtname == .c || resourceExtname == .cpp)"
      },
      {
        "command": "dtyp.scaffoldContest",
        "key": "ctrl+f9"
      }
    ],
    "configuration": {
      "title": "dTyp Configuration",
      "properties": {
        "dtyp.typingMode": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "default": "automatic",
          "description": "Typing mode: 'automatic' types characters sequentially with realistic delay. 'manual' queues code and outputs character-by-character per Ctrl+Shift+D press."
        },
        "dtyp.stepSize": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 50,
          "description": "Number of characters typed per Ctrl+Shift+D press in manual mode."
        },
        "dtyp.typingDelayMs": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 1000,
          "description": "Typing delay in milliseconds per character in automatic mode (1 to 1000ms)."
        },
        "dtyp.undoChunkSize": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of characters grouped per Ctrl+Z undo chunk during typing (default: 3 characters max)."
        },
        "dtyp.onCursorJump": {
          "type": "string",
          "enum": [
            "pause",
            "realign",
            "abort"
          ],
          "default": "realign",
          "description": "Behavior when cursor manually changes position during active typing: 'realign' seamlessly maintains cursor memory and keeps typing at head, 'pause' pauses typing, 'abort' terminates typing."
        },
        "dtyp.pauseOnTabSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically pause typing if user switches editor tabs or files."
        },
        "dtyp.typingJitterMs": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 50,
          "description": "Randomized human jitter (in milliseconds) added to typing delays for realistic keystroke timing."
        },
        "dtyp.naturalTypingModel": {
          "type": "string",
          "enum": [
            "nonlinear",
            "humanized",
            "linear"
          ],
          "default": "nonlinear",
          "description": "Typing model: 'nonlinear' (recommended) scaffolds headers and main() first, moves above main() for types and helper functions, and enters main() for driver logic; 'humanized' simulates cadence bursts linearly; 'linear' outputs raw character stream."
        },
        "dtyp.cognitivePauseIntensity": {
          "type": "string",
          "enum": [
            "subtle",
            "natural",
            "deliberate"
          ],
          "default": "natural",
          "description": "Intensity of cognitive human hesitations (control flow formulation, statement pauses, fatigue micro-rests)."
        },
        "dtyp.enableFatigueRenewal": {
          "type": "boolean",
          "default": true,
          "description": "Simulate motor stamina fatigue and organic renewal over prolonged typing bursts."
        },
        "dtyp.enableTypoSimulation": {
          "type": "boolean",
          "default": true,
          "description": "Enable realistic human typo simulation with automatic backspace self-correction."
        },
        "dtyp.typoRate": {
          "type": "number",
          "default": 0.015,
          "minimum": 0,
          "maximum": 0.1,
          "description": "Probability of human typo on alphabetic keystrokes (0.015 = 1.5% typo rate)."
        },
        "dtyp.enableChameleonMode": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, pressing any random key on your physical keyboard will output the exact next character from the queued C code (Chameleon Ghost-Typing)."
        },
        "dtyp.enableFalseStarts": {
          "type": "boolean",
          "default": false,
          "description": "Simulate natural mid-thought retractions and cognitive false starts when typing C variable declarations and expressions."
        },
        "dtyp.falseStartRate": {
          "type": "number",
          "default": 0.01,
          "minimum": 0,
          "maximum": 0.1,
          "description": "Probability of mid-thought false start on identifiers (0.01 = 1% rate)."
        },
        "dtyp.soundFeedback": {
          "type": "boolean",
          "default": true,
          "description": "Enable synthesized mechanical keyboard sound feedback in the stepping HUD."
        },
        "dtyp.switchProfile": {
          "type": "string",
          "enum": [
            "blue",
            "brown",
            "thock",
            "muted"
          ],
          "default": "blue",
          "description": "Synthesized switch acoustic profile: 'blue' (Cherry MX Blue clicky), 'brown' (tactile bump), 'thock' (Gateron Black deep thock), or 'muted' (quiet linear)."
        },
        "dtyp.academicBraceStyle": {
          "type": "string",
          "enum": [
            "kr",
            "allman"
          ],
          "default": "kr",
          "description": "Academic formatting brace style: 'kr' (Kernighan & Ritchie - opening brace on same line) or 'allman' (opening brace on its own line)."
        },
        "dtyp.analyzeMemoryAllocations": {
          "type": "boolean",
          "default": true,
          "description": "Enable dynamic memory leak warnings and heap allocation checks."
        },
        "dtyp.checkDuplicates": {
          "type": "boolean",
          "default": true,
          "description": "Prevent duplicate struct or function definitions from being inserted."
        },
        "dtyp.autoIncludeHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert missing standard headers (like <stdlib.h>, <stdbool.h>) needed by the component."
        },
        "dtyp.showReleaseNotesOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the release notes webview after installing or updating to a new version."
        },
        "dtyp.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Periodically check GitHub releases for extension updates."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dtyp-explorer",
          "title": "dTyp",
          "icon": "images/dtyp-activitybar.svg"
        }
      ]
    },
    "views": {
      "dtyp-explorer": [
        {
          "id": "dtyp.libraryView",
          "name": "Offline C Library (665)"
        },
        {
          "id": "dtyp.ownLibraryView",
          "name": "Own Library"
        },
        {
          "id": "dtyp.favoritesView",
          "name": "Favorites & Pinned"
        },
        {
          "id": "dtyp.historyView",
          "name": "Recent Insertions"
        },
        {
          "id": "dtyp.quickActionsView",
          "name": "Quick Controls"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "dtyp.compileAndRun",
          "when": "resourceExtname == .c || resourceExtname == .cpp",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "dtyp.openControlCenter",
          "when": "view == 'dtyp.quickActionsView' || view == 'dtyp.libraryView'",
          "group": "navigation@0"
        },
        {
          "command": "dtyp.refreshViews",
          "when": "view == 'dtyp.libraryView' || view == 'dtyp.favoritesView' || view == 'dtyp.historyView' || view == 'dtyp.quickActionsView'",
          "group": "navigation"
        },
        {
          "command": "dtyp.createOwnComponent",
          "when": "view == 'dtyp.ownLibraryView'",
          "group": "navigation@1"
        },
        {
          "command": "dtyp.refreshOwnLibrary",
          "when": "view == 'dtyp.ownLibraryView'",
          "group": "navigation@2"
        },
        {
          "command": "dtyp.exportOwnLibrary",
          "when": "view == 'dtyp.ownLibraryView'",
          "group": "navigation@3"
        },
        {
          "command": "dtyp.importOwnLibrary",
          "when": "view == 'dtyp.ownLibraryView'",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "dtyp.insertComponentById",
          "when": "view == 'dtyp.libraryView' && viewItem == 'component'",
          "group": "inline@1"
        },
        {
          "command": "dtyp.toggleFavorite",
          "when": "view == 'dtyp.libraryView' && viewItem == 'component'",
          "group": "inline@2"
        },
        {
          "command": "dtyp.copyComponentCode",
          "when": "view == 'dtyp.libraryView' && viewItem == 'component'",
          "group": "inline@3"
        },
        {
          "command": "dtyp.viewDocumentation",
          "when": "view == 'dtyp.libraryView' && viewItem == 'component'",
          "group": "inline@4"
        },
        {
          "command": "dtyp.visualizeComponent",
          "when": "view == 'dtyp.libraryView' && viewItem == 'component'",
          "group": "inline@5"
        },
        {
          "command": "dtyp.insertOwnComponent",
          "when": "view == 'dtyp.ownLibraryView' && viewItem == 'ownComponent'",
          "group": "inline@1"
        },
        {
          "command": "dtyp.editOwnComponent",
          "when": "view == 'dtyp.ownLibraryView' && viewItem == 'ownComponent'",
          "group": "inline@2"
        },
        {
          "command": "dtyp.copyOwnComponentCode",
          "when": "view == 'dtyp.ownLibraryView' && viewItem == 'ownComponent'",
          "group": "inline@3"
        },
        {
          "command": "dtyp.deleteOwnComponent",
          "when": "view == 'dtyp.ownLibraryView' && viewItem == 'ownComponent'",
          "group": "inline@4"
        }
      ]
    },
