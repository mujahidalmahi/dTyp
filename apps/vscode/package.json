        "icon": "$(refresh)"
      },
      {
        "command": "dtyp.exportOwnLibrary",
        "title": "dTyp: Export Own Library to JSON...",
        "category": "dTyp",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dtyp.importOwnLibrary",
        "title": "dTyp: Import Own Library from JSON...",
        "category": "dTyp",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dtyp.compileAndRun",
        "title": "dTyp: Compile & Run in Terminal",
        "category": "dTyp",
        "icon": "$(play)"
      },
      {
        "command": "dtyp.visualizeComponent",
        "title": "dTyp: Visualize Data Structure & Memory",
        "category": "dTyp",
        "icon": "$(eye)"
      },
      {
        "command": "dtyp.previewComponent",
        "title": "dTyp: Preview Ghost Code",
        "category": "dTyp",
        "icon": "$(preview)"
      },
      {
        "command": "dtyp.speedUpTyping",
        "title": "dTyp: Speed Up Typing (+25%)",
        "category": "dTyp",
        "icon": "$(fast-forward)"
      },
      {
        "command": "dtyp.slowDownTyping",
        "title": "dTyp: Slow Down Typing (-20%)",
        "category": "dTyp",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "dtyp.toggleChameleonMode",
        "title": "dTyp: Toggle Chameleon Ghost-Typing Mode (Alt+C)",
        "category": "dTyp",
        "icon": "$(eye)"
      },
      {
        "command": "dtyp.runTestCases",
        "title": "dTyp: Run Multi-Test Sandbox (Ctrl+F6)",
        "category": "dTyp",
        "icon": "$(beaker)"
      },
      {
        "command": "dtyp.runSanitizer",
        "title": "dTyp: Run AddressSanitizer & UB Guard (Ctrl+F7)",
