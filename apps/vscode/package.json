      },
      {
        "command": "dtyp.refreshViews",
        "title": "dTyp: Refresh Views",
        "category": "dTyp",
        "icon": "$(refresh)"
      },
      {
        "command": "dtyp.viewDocumentation",
        "title": "dTyp: View Component Documentation...",
        "category": "dTyp",
        "icon": "$(book)"
      },
      {
        "command": "dtyp.analyzeMemory",
