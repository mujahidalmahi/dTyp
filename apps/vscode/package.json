{
  "name": "dtyp-vscode",
  "displayName": "dTyp — Don't Tell Your Professor",
  "description": "Offline academic C programming library & automated character-by-character typing assistant",
  "version": "4.0.0",
  "publisher": "1da7b1e6-01f1-6f58-9ef3-d95516c5e875",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mujahidalmahi/dTyp.git"
  },
  "homepage": "https://github.com/mujahidalmahi/dTyp#readme",
  "bugs": {
    "url": "https://github.com/mujahidalmahi/dTyp/issues"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "c",
    "academic",
    "snippets",
    "typing",
    "data-structures",
    "algorithms",
    "automation",
    "offline",
    "boiler-plate"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:dtyp.insertComponent",
    "onCommand:dtyp.quickInsert",
    "onCommand:dtyp.typeNextCharacter",
    "onCommand:dtyp.flushRemaining",
    "onCommand:dtyp.browseLibrary",
    "onCommand:dtyp.insertSnippet",
    "onCommand:dtyp.showHistory",
    "onCommand:dtyp.cancelTyping",
    "onView:dtyp.libraryView",
    "onView:dtyp.favoritesView",
    "onView:dtyp.historyView",
    "onView:dtyp.quickActionsView",
    "onView:dtyp.ownLibraryView",
    "onCommand:dtyp.showReleaseNotes",
    "onCommand:dtyp.checkForUpdates",
    "onCommand:dtyp.healthCheck",
    "onCommand:dtyp.toggleTypingMode",
    "onCommand:dtyp.refreshViews",
    "onCommand:dtyp.viewDocumentation",
    "onCommand:dtyp.analyzeMemory",
    "onCommand:dtyp.jumpToNextPlaceholder",
    "onCommand:dtyp.jumpToPrevPlaceholder",
    "onCommand:dtyp.renewQueue",
    "onCommand:dtyp.rewindStep",
    "onCommand:dtyp.renewComponent",
    "onCommand:dtyp.createOwnComponent",
    "onCommand:dtyp.editOwnComponent",
    "onCommand:dtyp.deleteOwnComponent",
    "onCommand:dtyp.insertOwnComponent",
    "onCommand:dtyp.copyOwnComponentCode",
    "onCommand:dtyp.refreshOwnLibrary",
    "onCommand:dtyp.exportOwnLibrary",
    "onCommand:dtyp.importOwnLibrary",
    "onCommand:dtyp.togglePauseTyping",
    "onCommand:dtyp.pauseTyping",
    "onCommand:dtyp.resumeTyping",
    "onCommand:dtyp.toggleChameleonMode",
    "onCommand:dtyp.runTestCases",
    "onCommand:dtyp.runSanitizer",
    "onCommand:dtyp.modularize",
    "onCommand:dtyp.benchmarkComponent",
    "onCommand:dtyp.openFlashcards",
    "onCommand:dtyp.toggleSteppingHud",
    "onCommand:dtyp.showShortcuts",
    "onCommand:dtyp.formatAcademic",
    "onCommand:dtyp.auditCode",
    "onCommand:dtyp.scaffoldContest",
    "onCommand:dtyp.visualizeRecursion",
    "onCommand:dtyp.runValgrind",
    "onCommand:dtyp.openTypingDrill",
    "onCommand:dtyp.openControlCenter",
    "onCommand:dtyp.openStatusBarMenu"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dtyp.insertComponent",
        "title": "dTyp: Search & Insert Component...",
        "category": "dTyp"
      },
      {
        "command": "dtyp.quickInsert",
        "title": "dTyp: Quick Insert (Fuzzy Search)",
        "category": "dTyp"
      },
      {
        "command": "dtyp.typeNextCharacter",
        "title": "dTyp: Step Next Character",
        "category": "dTyp"
      },
      {
        "command": "dtyp.flushRemaining",
        "title": "dTyp: Flush Remaining Characters",
        "category": "dTyp"
      },
      {
        "command": "dtyp.browseLibrary",
        "title": "dTyp: Browse Offline Library...",
        "category": "dTyp"
      },
      {
        "command": "dtyp.insertSnippet",
        "title": "dTyp: Insert Snippet...",
        "category": "dTyp"
      },
      {
        "command": "dtyp.showHistory",
        "title": "dTyp: Show Insertion History",
        "category": "dTyp"
      },
      {
        "command": "dtyp.cancelTyping",
        "title": "dTyp: Cancel Typing / Clear Queue",
        "category": "dTyp"
      },
      {
        "command": "dtyp.togglePauseTyping",
        "title": "dTyp: Pause / Resume Typing",
        "category": "dTyp",
