{
  "name": "dtyp-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "dTyp - Don't Tell Your Professor (Offline Academic C Library & VS Code Extension)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:types": "npm --workspace=@dtyp/types run build",
    "build:utilities": "npm --workspace=@dtyp/utilities run build",
    "build:validation": "npm --workspace=@dtyp/validation run build",
    "build:typing-engine": "npm --workspace=@dtyp/typing-engine run build",
    "build:library-engine": "npm --workspace=@dtyp/library-engine run build",
    "build": "npm run build:types && npm run build:utilities && npm run build:validation && npm run build:typing-engine && npm run build:library-engine",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:taxonomy": "tsx scripts/library/generators/taxonomy-builder.ts",
    "generate:library": "tsx scripts/library/generators/generate-all.ts",
    "validate:library": "tsx scripts/validation/validate-library.ts",
    "build:db": "tsx scripts/database/build-db.ts",
    "vscode:bundle": "npm --workspace=dtyp-vscode run bundle",
    "vscode:package": "npm --workspace=dtyp-vscode run package",
    "bump:patch": "tsx scripts/version/bump.ts patch",
    "bump:minor": "tsx scripts/version/bump.ts minor",
    "bump:major": "tsx scripts/version/bump.ts major"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "typing",
    "automation",
    "vscode",
    "c-programming",
    "academic-library"
  ],
  "author": "Mujahid Al Mahi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mujahidalmahi/dTyp.git"
  },
  "homepage": "https://github.com/mujahidalmahi/dTyp#readme",
  "bugs": {
    "url": "https://github.com/mujahidalmahi/dTyp/issues"
  }
}
